# ==========================================
# KONFIGURASI BOT WHATSAPP ASCII-IF
# ==========================================

# Database SQLite untuk sesi WhatsApp
DB_PATH=whatsapp.db

# Prefix command bot (default: !)
BOT_PREFIX=!

# Opsi Pairing Code (true jika ingin pakai 8-digit code, false jika scan QR)
PAIRING_MODE=false
PHONE_NUMBER=628xxxxxxxxxx

# ==========================================
# INTEGRASI KE WEB UTAMA (ASCII-IF)
# ==========================================
# URL endpoint REST API dari web ascii-if (lokal atau produksi)
# Lokal: http://localhost:3000/api
# Produksi: https://ascii.web.id/api
ASCII_API_URL=http://localhost:3000/api

# API Secret Key / Bot Key yang sesuai dengan env API_SECRET_KEY / BOT_API_KEY di web ascii-if
ASCII_API_KEY=your-ascii-bot-secret-key

# URL Web Portal utama untuk tautan
ASCII_WEB_URL=https://ascii.web.id

# ==========================================
# WEBHOOK / REST SERVER BOT (DARI WEB KE WA)
# ==========================================
ENABLE_SERVER=true
SERVER_PORT=8080

# Token rahasia yang wajib dikirim oleh web ascii-if saat memanggil bot (Header: X-Bot-Secret)
BOT_SECRET=ascii-secret-bot-key
